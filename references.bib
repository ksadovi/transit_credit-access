@article{tyndall_airports,
    title = {The local labour market effects of light rail transit},
    volume = {124},
    issn = {0094-1190},
    url = {https://www.sciencedirect.com/science/article/pii/S0094119021000322},
    doi = {https://doi.org/10.1016/j.jue.2021.103350},
    abstract = {Many US cities have made large investments in light rail transit in order to improve commuting networks. I analyse the labour market effects of light rail in four US metros. I propose a new instrumental variable to overcome endogeneity in transit station location, enabling causal identification of neighbourhood effects. Light rail stations are found to drastically improve employment outcomes in the surrounding neighbourhood. To incorporate endogenous sorting by workers, I estimate a structural neighbourhood choice model. Light rail systems tend to raise rents in accessible locations, displacing lower skilled workers to isolated neighbourhoods, which reduces aggregate metropolitan employment in equilibrium.},
    journal = {Journal of Urban Economics},
    author = {Tyndall, Justin},
    year = {2021},
    keywords = {Neighbourhood change, Residential choice, Spatial mismatch, Transit, Transportation},
    pages = {103350},
}
